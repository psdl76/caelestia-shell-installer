# Maintainer: psdl76
pkgname=caelestia-webapps
pkgver=0.4.3
pkgrel=1
pkgdesc="Unofficial Firefox WebApp manager for Hyprland and Caelestia-style desktops"
arch=('any')
url="https://github.com/psdl76/caelestia-shell-installer"
license=('GPL-3.0-only')
depends=('bash' 'python' 'firefox' 'hyprland' 'quickshell' 'hicolor-icon-theme')
optdepends=(
  'desktop-file-utils: refresh the desktop application database'
  'gtk-update-icon-cache: refresh the hicolor icon cache for installed WebApps'
)
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('2709d273bc79d1c61891a77cfb9aa778796336fecde8198f4bc0cc2f3a6c8cc0')

package() {
  local src="$srcdir/$pkgname-$pkgver"
  local core="$pkgdir/usr/lib/$pkgname"

  install -dm755 "$core"
  cp -a --no-preserve=ownership \
    "$src/VERSION" \
    "$src/apps" \
    "$src/assets" \
    "$src/bin" \
    "$src/config" \
    "$src/data" \
    "$src/lib" \
    "$src/manager" \
    "$src/scripts" \
    "$src/templates" \
    "$src/catalog.sh" \
    "$src/install.sh" \
    "$src/repair.sh" \
    "$src/uninstall.sh" \
    "$src/upgrade.sh" \
    "$src/manager.sh" \
    "$core/"

  install -Dm755 "$src/packaging/arch/wrappers/caelestia-webapps" \
    "$pkgdir/usr/bin/caelestia-webapps"
  install -Dm755 "$src/packaging/arch/wrappers/caelestia-webapps-manager" \
    "$pkgdir/usr/bin/caelestia-webapps-manager"
  install -Dm644 "$src/packaging/caelestia-webapps-manager.desktop" \
    "$pkgdir/usr/share/applications/caelestia-webapps-manager.desktop"
  install -Dm644 "$src/assets/branding/caelestia-webapps.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/caelestia-webapps.svg"
  install -Dm644 "$src/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
