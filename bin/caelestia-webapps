    except (OSError, json.JSONDecodeError):
        return False
    pins = data.get("pins", {}) if isinstance(data, dict) else {}
    return bool(pins.get(app_id, False)) if isinstance(pins, dict) else False


def set_pin_state(app_id: str, enabled: bool) -> None:
    path = _pin_state_path()
