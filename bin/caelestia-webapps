#!/usr/bin/env python3
from __future__ import annotations

import contextlib
import fcntl
import json
import os
import base64
import hashlib
import re
import shlex
import socket
import struct
import signal
import shutil
import subprocess
import sys
import time
import tempfile
from pathlib import Path
from urllib.parse import urlparse
from typing import Any

API_VERSION = 1
EXIT_OK = 0
EXIT_USAGE = 2
EXIT_UNKNOWN_APP = 10
EXIT_NOT_INSTALLED = 11
EXIT_LAUNCHER_MISSING = 12
EXIT_CATALOG_ERROR = 20
EXIT_ACTION_FAILED = 30
EXIT_ACTION_BUSY = 31
EXIT_ACTION_TIMEOUT = 32
LOCK_BUSY_EXIT = 75

ROOT = Path(__file__).resolve().parent.parent
APP_DIR = ROOT / "apps"
CATALOG_SCRIPT = ROOT / "catalog.sh"
INSTALL_SCRIPT = ROOT / "install.sh"
REPAIR_SCRIPT = ROOT / "repair.sh"
UNINSTALL_SCRIPT = ROOT / "uninstall.sh"
USER_APPS_TOOL = ROOT / "scripts/user_apps.py"
NOTIFICATION_WATCH_TOOL = ROOT / "scripts/notification_watch.py"
DEFINITION_VALIDATOR = ROOT / "scripts/validate_definitions.py"
APPLET_REGISTRY_GENERATOR = ROOT / "scripts/generate_applet_registry.py"
APPLET_REGISTRY_VALIDATOR = ROOT / "scripts/validate_applet_registry.py"
APPLET_IMPLEMENTATION_VALIDATOR = ROOT / "scripts/validate_applet_implementations.py"
APPLET_RUNTIME_SOURCE_VALIDATOR = ROOT / "scripts/validate_applet_runtime_sources.py"
CATALOG_FILE = Path.home() / ".local/share/caelestia-webapps/catalog.json"
APPLET_REGISTRY_FILE = Path.home() / ".local/share/caelestia-webapps/applet-registry.json"


def _lock_path() -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR", "").strip()
    if runtime:
        return Path(runtime) / "caelestia-webapps" / "mutation.lock"
    return Path.home() / ".local/state/caelestia-webapps/locks/mutation.lock"

@contextlib.contextmanager
def engine_lock(command: str, exclusive: bool):
    inherited = os.environ.get("CAELESTIA_WEBAPPS_LOCK_HELD", "")
    if inherited == "exclusive" or (not exclusive and inherited == "shared"):
        yield
        return
    path = _lock_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    timeout = max(float(os.environ.get("CAELESTIA_WEBAPPS_LOCK_TIMEOUT_SECONDS", "2")), 0.0)
    deadline = time.monotonic() + timeout
    mode = fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH
    with path.open("a+") as handle:
        while True:
            try:
                fcntl.flock(handle.fileno(), mode | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    error(command, "action_busy", "Eine andere WebApps-Aktion läuft bereits.", EXIT_ACTION_BUSY)
                time.sleep(0.05)
        old = os.environ.get("CAELESTIA_WEBAPPS_LOCK_HELD")
        os.environ["CAELESTIA_WEBAPPS_LOCK_HELD"] = "exclusive" if exclusive else "shared"
        try:
            yield
        finally:
            if old is None:
                os.environ.pop("CAELESTIA_WEBAPPS_LOCK_HELD", None)
            else:
                os.environ["CAELESTIA_WEBAPPS_LOCK_HELD"] = old
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def run_action_capture(
    command: str,
    argv: list[str],
    extra_env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    timeout = max(float(os.environ.get("CAELESTIA_WEBAPPS_ACTION_TIMEOUT_SECONDS", "120")), 1.0)
    try:
        action_env = os.environ.copy()
        if extra_env:
            action_env.update(extra_env)
        proc = subprocess.Popen(
            argv,
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=action_env,
            start_new_session=True,
        )
    except OSError:
        error(command, "action_unavailable", f"Engine-Aktion '{command}' konnte nicht gestartet werden.", EXIT_ACTION_FAILED)
    try:
        stdout, stderr = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGTERM)
            proc.communicate(timeout=2.0)
        except (ProcessLookupError, subprocess.TimeoutExpired):
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            proc.communicate()
        error(command, "action_timeout", f"Engine-Aktion '{command}' hat das Zeitlimit überschritten.", EXIT_ACTION_TIMEOUT)
    return subprocess.CompletedProcess(argv, proc.returncode, stdout, stderr)

def emit(payload: dict[str, Any], exit_code: int = EXIT_OK) -> "NoReturn":
    payload = {"apiVersion": API_VERSION, **payload}
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=False))
    raise SystemExit(exit_code)


def success(command: str, data: Any = None, message: str | None = None) -> "NoReturn":
    payload: dict[str, Any] = {"ok": True, "command": command}
    if message is not None:
        payload["message"] = message
    if data is not None:
        payload["data"] = data
    emit(payload, EXIT_OK)


def error(command: str, code: str, message: str, exit_code: int) -> "NoReturn":
    emit(
        {
            "ok": False,
            "command": command,
            "error": {"code": code, "message": message},
        },
        exit_code,
    )


def known_app(app_id: str) -> bool:
    if not app_id:
        return False
    try:
        catalog = load_catalog()
    except SystemExit:
        return False
    return any(
        isinstance(app, dict) and app.get("id") == app_id
        for app in catalog.get("apps", [])
    )


def require_known_app(command: str, app_id: str) -> None:
    if not known_app(app_id):
        error(command, "unknown_app", f"Unbekannte App-ID: {app_id}", EXIT_UNKNOWN_APP)


def run_capture(argv: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        argv,
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
        env=os.environ.copy(),
    )


def load_catalog() -> dict[str, Any]:
    # Normal catalog reads are strictly read-only. Bootstrap the persisted
    # catalog+registry pair only when it does not exist yet, and do so under
    # the exclusive mutation lock before entering the shared read section.
    if not CATALOG_FILE.is_file() or not APPLET_REGISTRY_FILE.is_file():
        with engine_lock("catalog-bootstrap", exclusive=True):
            if not CATALOG_FILE.is_file() or not APPLET_REGISTRY_FILE.is_file():
                rebuilt = run_capture([str(CATALOG_SCRIPT), "rebuild"])
                if rebuilt.returncode != 0:
                    error("catalog", "catalog_error", rebuilt.stderr.strip() or "Katalog konnte nicht erzeugt werden.", EXIT_CATALOG_ERROR)
    with engine_lock("catalog", exclusive=False):
        proc = run_capture([str(CATALOG_SCRIPT), "json"])
    if proc.returncode != 0:
        error("catalog", "catalog_error", "Katalog konnte nicht erzeugt werden.", EXIT_CATALOG_ERROR)
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        error("catalog", "invalid_catalog", "Katalog enthält kein gültiges JSON.", EXIT_CATALOG_ERROR)
    if (
        not isinstance(payload, dict)
        or payload.get("schemaVersion") != 2
        or not isinstance(payload.get("categories"), list)
        or not isinstance(payload.get("apps"), list)
    ):
        error("catalog", "invalid_catalog", "Katalog besitzt nicht das erwartete Schema v2.", EXIT_CATALOG_ERROR)
    return payload


_APP_ID_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")
_RUNTIME_ID_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def _parse_installed_conf(path: Path) -> dict[str, str] | None:
    """Parse package-written metadata without evaluating it as shell code."""
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return None

    values: dict[str, str] = {}
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            return None
        key, raw_value = line.split("=", 1)
        if not re.fullmatch(r"[A-Z][A-Z0-9_]*", key) or key in values:
            return None
        try:
            parts = shlex.split(raw_value, posix=True)
        except ValueError:
            return None
        if len(parts) != 1:
            return None
        values[key] = parts[0]
    return values


def _category_ids() -> set[str]:
    try:
        payload = json.loads((ROOT / "config/categories.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return set()
    categories = payload.get("categories", {})
    return set(categories) if isinstance(categories, dict) else set()


def _orphan_from_directory(app_dir: Path, known_ids: set[str]) -> dict[str, Any] | None:
    app_id = app_dir.name
    if app_id in known_ids or not _APP_ID_RE.fullmatch(app_id) or app_dir.is_symlink():
        return None

    metadata_path = app_dir / "installed.conf"
    if not metadata_path.is_file() or metadata_path.is_symlink():
        return None
    values = _parse_installed_conf(metadata_path)
    if values is None or values.get("APP_ID") != app_id:
        return None

    app_name = values.get("APP_NAME", "").strip()
    app_url = values.get("APP_URL", "").strip()
    window_class = values.get("WINDOW_CLASS", "").strip()
    remoting_name = values.get("MOZ_APP_REMOTINGNAME", "").strip()
    category = values.get("APP_CATALOG_CATEGORY", "").strip()
    opaque = values.get("USE_OPAQUE_TAG", "").strip().lower()
    parsed_url = urlparse(app_url)
    if (
        not app_name
        or len(app_name) > 200
        or any(ord(char) < 32 for char in app_name)
        or parsed_url.scheme not in {"http", "https"}
        or not parsed_url.netloc
        or len(app_url) > 4096
        or not _RUNTIME_ID_RE.fullmatch(window_class)
        or not _RUNTIME_ID_RE.fullmatch(remoting_name)
        or category not in _category_ids()
        or opaque not in {"true", "false"}
    ):
        return None

    data_root = Path.home() / ".local/share/caelestia-webapps"
    launcher = Path.home() / ".local/bin" / f"caelestia-webapp-{app_id}"
    setup_launcher = Path.home() / ".local/bin" / f"caelestia-webapp-{app_id}-setup"
    desktop_file = Path.home() / ".local/share/applications" / f"caelestia-webapp-{app_id}.desktop"
    icon_file = Path.home() / ".local/share/icons/hicolor/scalable/apps" / f"{app_id}.svg"
    profile_dir = data_root / "apps" / app_id / "profile"
    expected_paths = {
        "LAUNCHER": launcher,
        "SETUP_LAUNCHER": setup_launcher,
        "DESKTOP_FILE": desktop_file,
        "ICON_FILE": icon_file,
        "PROFILE_DIR": profile_dir,
    }
    if any(values.get(key) != str(expected) for key, expected in expected_paths.items()):
        return None

    return {
        "id": app_id,
        "name": app_name,
        "genericName": "Web Application",
        "comment": "Installed WebApp without a current catalog definition",
        "url": app_url,
        "category": category,
        "categories": [category],
        "provider": "legacy",
        "tags": [],
        "featured": False,
        "applet": {
            "available": False,
            "defaultEnabled": False,
            "adapter": "none",
            "support": "none",
            "capabilities": [],
            "matchHosts": [],
        },
        "installed": True,
        "source": "orphan",
        "orphaned": True,
        "orphanReason": "definition_missing",
        "ownership": {
            "owner": "recovery",
            "definitionMutable": False,
            "survivesUpgrade": True,
            "removableFromCatalog": False,
        },
        "capabilities": {
            "launch": False,
            "setup": False,
            "install": False,
            "repair": False,
            "uninstall": True,
            "edit": False,
        },
        "windowClass": window_class,
        "browserBridge": {"port": 0, "kind": "none"},
        "iconName": app_id,
        "iconProvider": "",
        "iconId": app_id,
        "icon": str(icon_file),
        "iconLocal": "",
        "iconUrl": "",
        "iconMode": "local",
        "iconStore": "",
        "launcher": str(launcher),
        "setupLauncher": str(setup_launcher),
        "notificationMatch": values.get("NOTIFICATION_MATCH", app_name),
        "notificationMatches": [values.get("NOTIFICATION_MATCH", app_name)],
        "specialWorkspace": "",
        "appletVisible": False,
        "appletShowBadge": False,
        "appletNotificationPreview": False,
        "recovery": {
            "metadata": str(metadata_path),
            "useOpaqueTag": opaque == "true",
            "remotingName": remoting_name,
            "canRestore": (
                window_class == app_id
                and remoting_name == app_id
                and icon_file.is_file()
                and not icon_file.is_symlink()
            ),
        },
    }


def orphan_installations(catalog: dict[str, Any] | None = None) -> list[dict[str, Any]]:
    current = catalog if catalog is not None else load_catalog()
    known_ids = {
        str(app.get("id"))
        for app in current.get("apps", [])
        if isinstance(app, dict) and app.get("id")
    }
    apps_root = Path.home() / ".local/share/caelestia-webapps/apps"
    try:
        candidates = sorted(apps_root.iterdir(), key=lambda item: item.name)
    except OSError:
        return []
    result = []
    for candidate in candidates:
        if not candidate.is_dir():
            continue
        orphan = _orphan_from_directory(candidate, known_ids)
        if orphan is not None:
            result.append(orphan)
    return result


def orphan_by_id(command: str, app_id: str) -> dict[str, Any]:
    if not _APP_ID_RE.fullmatch(app_id):
        error(command, "invalid_app_id", f"Ungültige App-ID: {app_id}", EXIT_UNKNOWN_APP)
    match = next((app for app in orphan_installations() if app.get("id") == app_id), None)
    if match is None:
        error(command, "unknown_orphan", f"Keine sicher bereinigbare verwaiste Installation: {app_id}", EXIT_UNKNOWN_APP)
    return match


def catalog_with_orphans(catalog: dict[str, Any] | None = None) -> dict[str, Any]:
    current = catalog if catalog is not None else load_catalog()
    return {**current, "apps": [*current.get("apps", []), *orphan_installations(current)]}



def load_applet_registry() -> dict[str, Any]:
    """Load the persisted Phase 16.3 registry produced by catalog.sh.

    Runtime consumers must use this persisted projection as the sole
    source for applet integration metadata.
    """
    if not APPLET_REGISTRY_FILE.is_file():
        load_catalog()
    try:
        registry = json.loads(APPLET_REGISTRY_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        error("applet-registry", "invalid_registry", "Persistierte Applet Registry fehlt oder enthält kein gültiges JSON.", EXIT_CATALOG_ERROR)
    if not isinstance(registry, dict) or registry.get("schemaVersion") != 1 or not isinstance(registry.get("apps"), list):
        error("applet-registry", "invalid_registry", "Applet Registry besitzt nicht das erwartete Schema v1.", EXIT_CATALOG_ERROR)
    return registry


def applet_registry_index() -> dict[str, dict[str, Any]]:
    registry = load_applet_registry()
    return {
        str(item.get("id")): item
        for item in registry.get("apps", [])
        if isinstance(item, dict) and item.get("id")
    }

def applet_runtime_entry(command: str, app_id: str) -> dict[str, Any]:
    """Return the authoritative Phase 16.3 runtime metadata for one applet.

    Applet runtime code must not reconstruct adapter metadata from catalog.json.
    The catalog remains the product/store model; applet-registry.json is the
    sole runtime projection for applet integration metadata.
    """
    entry = applet_registry_index().get(app_id)
    if not isinstance(entry, dict):
        error(command, "applet_not_available", f"App {app_id} besitzt keine Applet-Runtime-Registry.", EXIT_CATALOG_ERROR)
    return entry

def app_from_catalog(command: str, app_id: str) -> dict[str, Any]:
    require_known_app(command, app_id)
    catalog = load_catalog()
    for app in catalog["apps"]:
        if isinstance(app, dict) and app.get("id") == app_id:
            return app
    error(command, "catalog_mismatch", f"App {app_id} fehlt im Katalog.", EXIT_CATALOG_ERROR)



def hyprland_window_state(catalog: dict[str, Any]) -> dict[str, Any]:
    """Return transient running state without writing it into catalog.json."""
    classes = {
        str(app.get("id", "")): str(app.get("windowClass", "")).casefold()
        for app in catalog.get("apps", [])
        if isinstance(app, dict) and app.get("id")
    }
    state: dict[str, dict[str, Any]] = {
        app_id: {"running": False, "windowCount": 0}
        for app_id in classes
    }

    try:
        proc = subprocess.run(
            ["hyprctl", "clients", "-j"],
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            timeout=1.5,
            env=os.environ.copy(),
        )
    except (OSError, subprocess.TimeoutExpired):
        return {"available": False, "apps": state}

    if proc.returncode != 0:
        return {"available": False, "apps": state}

    try:
        clients = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {"available": False, "apps": state}

    if not isinstance(clients, list):
        return {"available": False, "apps": state}

    for client in clients:
        if not isinstance(client, dict):
            continue
        observed = {
            str(client.get("class", "")).casefold(),
            str(client.get("initialClass", "")).casefold(),
        }
        observed.discard("")
        if not observed:
            continue
        for app_id, window_class in classes.items():
            if window_class and window_class in observed:
                state[app_id]["windowCount"] += 1
                state[app_id]["running"] = True

    return {"available": True, "apps": state}


def runtime_state(
    app: dict[str, Any], transient: dict[str, Any] | None = None
) -> dict[str, Any]:
    app_id = str(app["id"])
    data_root = Path.home() / ".local/share/caelestia-webapps" / "apps" / app_id
    launcher = Path(str(app.get("launcher", "")))
    setup_launcher = Path(str(app.get("setupLauncher", "")))
    transient_app = (transient or {}).get("apps", {}).get(
        app_id, {"running": False, "windowCount": 0}
    )
    return {
        "installed": bool(app.get("installed", False)),
        "metadataExists": (data_root / "installed.conf").is_file(),
        "profileExists": (data_root / "profile").is_dir(),
        "launcherExists": launcher.is_file(),
        "launcherExecutable": os.access(launcher, os.X_OK) if launcher else False,
        "setupLauncherExists": setup_launcher.is_file(),
        "setupLauncherExecutable": os.access(setup_launcher, os.X_OK) if setup_launcher else False,
        "runningStateAvailable": bool((transient or {}).get("available", False)),
        "running": bool(transient_app.get("running", False)),
        "windowCount": int(transient_app.get("windowCount", 0)),
    }



def matching_hyprland_windows(catalog: dict[str, Any], app_id: str) -> list[str]:
    app = next(
        (
            item
            for item in catalog.get("apps", [])
            if isinstance(item, dict) and item.get("id") == app_id
        ),
        None,
    )
    if app is None:
        return []

    window_class = str(app.get("windowClass", "")).casefold()
    if not window_class:
        return []

    try:
        proc = run_capture(["hyprctl", "clients", "-j"])
    except OSError:
        return []

    if proc.returncode != 0:
        return []

    try:
        clients = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return []

    result: list[str] = []
    if not isinstance(clients, list):
        return result

    for client in clients:
        if not isinstance(client, dict):
            continue
        observed = {
            str(client.get("class", "")).casefold(),
            str(client.get("initialClass", "")).casefold(),
        }
        address = str(client.get("address", "")).strip()
        if window_class in observed and address:
            result.append(address)
    return result


def graceful_close_windows(
    command: str,
    app_id: str,
    timeout_seconds: float = 6.0,
    catalog: dict[str, Any] | None = None,
) -> None:
    catalog = catalog if catalog is not None else load_catalog()
    addresses = matching_hyprland_windows(catalog, app_id)
    if not addresses:
        return

    for address in addresses:
        selector = f"address:{address}"
        expression = f'hl.dsp.window.close({{ window = "{selector}" }})'
        try:
            proc = run_capture(["hyprctl", "dispatch", expression])
        except OSError:
            error(
                command,
                "window_close_unavailable",
                "Hyprland konnte nicht zum Schließen der WebApp angesprochen werden.",
                EXIT_ACTION_FAILED,
            )
        if proc.returncode != 0:
            error(
                command,
                "window_close_failed",
                "Das laufende WebApp-Fenster konnte nicht regulär geschlossen werden.",
                EXIT_ACTION_FAILED,
            )

    deadline = time.monotonic() + timeout_seconds
    while time.monotonic() < deadline:
        current = catalog_with_orphans() if any(
            app.get("orphaned") is True for app in catalog.get("apps", []) if isinstance(app, dict)
        ) else load_catalog()
        if not matching_hyprland_windows(current, app_id):
            return
        time.sleep(0.15)

    error(
        command,
        "window_close_timeout",
        "Die WebApp ist noch geöffnet. Deinstallation wurde zur Sicherheit abgebrochen.",
        EXIT_ACTION_FAILED,
    )


def close_and_uninstall(command: str, app_id: str) -> None:
    require_known_app(command, app_id)
    graceful_close_windows(command, app_id)
    delegate_action(command, [str(UNINSTALL_SCRIPT), app_id], app_id)


def orphan_uninstall(command: str, app_id: str, close_first: bool) -> None:
    orphan = orphan_by_id(command, app_id)
    recovery_catalog = catalog_with_orphans()
    addresses = matching_hyprland_windows(recovery_catalog, app_id)
    if addresses and not close_first:
        error(
            command,
            "app_running",
            "Die verwaiste WebApp läuft noch. Bitte zuerst schließen und dann bereinigen.",
            EXIT_ACTION_FAILED,
        )
    if close_first:
        graceful_close_windows(command, app_id, catalog=recovery_catalog)

    recovery = orphan.get("recovery", {})
    proc = run_action_capture(
        command,
        [str(UNINSTALL_SCRIPT), "--orphan", app_id],
        {
            "CAELESTIA_WEBAPPS_ORPHAN_RECOVERY": "1",
            "CAELESTIA_WEBAPPS_ORPHAN_APP_NAME": str(orphan.get("name", "")),
            "CAELESTIA_WEBAPPS_ORPHAN_APP_URL": str(orphan.get("url", "")),
            "CAELESTIA_WEBAPPS_ORPHAN_WINDOW_CLASS": str(orphan.get("windowClass", "")),
            "CAELESTIA_WEBAPPS_ORPHAN_MOZ_APP_REMOTINGNAME": str(recovery.get("remotingName", "")),
            "CAELESTIA_WEBAPPS_ORPHAN_CATEGORY": str(orphan.get("category", "")),
            "CAELESTIA_WEBAPPS_ORPHAN_USE_OPAQUE_TAG": "true" if recovery.get("useOpaqueTag") is True else "false",
        },
    )
    if proc.returncode == LOCK_BUSY_EXIT:
        error(command, "action_busy", "Eine andere WebApps-Aktion läuft bereits.", EXIT_ACTION_BUSY)
    if proc.returncode != 0:
        error(command, "action_failed", "Die verwaiste Installation konnte nicht sicher bereinigt werden.", EXIT_ACTION_FAILED)
    success(command, data={"appId": app_id, "removed": True, "orphaned": True})


def orphan_restore(command: str, app_id: str) -> None:
    orphan = orphan_by_id(command, app_id)
    recovery = orphan.get("recovery", {})
    if recovery.get("canRestore") is not True:
        error(
            command,
            "orphan_not_restorable",
            "Diese verwaiste Installation kann nicht eindeutig als Benutzer-WebApp wiederhergestellt werden.",
            EXIT_ACTION_FAILED,
        )
    payload = json.dumps(
        {
            "id": app_id,
            "name": str(orphan.get("name", "")),
            "url": str(orphan.get("url", "")),
            "category": str(orphan.get("category", "")),
            "iconMode": "local",
            "iconFile": str(orphan.get("icon", "")),
            "genericName": "Web Application",
            "comment": str(orphan.get("comment", "")),
            "notificationMatch": str(orphan.get("notificationMatch", orphan.get("name", ""))),
        },
        ensure_ascii=False,
    )
    user_definition_action(command, [str(USER_APPS_TOOL), "create", payload])



def running_feed_payload() -> dict[str, Any]:
    """Return transient Hyprland running state for all catalog WebApps."""
    catalog = load_catalog()
    transient = hyprland_window_state(catalog)
    apps = []
    for app in catalog.get("apps", []):
        if not isinstance(app, dict) or not app.get("id"):
            continue
        app_id = str(app["id"])
        state = transient.get("apps", {}).get(
            app_id, {"running": False, "windowCount": 0}
        )
        apps.append({
            "appId": app_id,
            "running": bool(state.get("running", False)),
            "windowCount": int(state.get("windowCount", 0)),
        })
    return {
        "available": bool(transient.get("available", False)),
        "apps": apps,
    }


def status_payload(app_id: str) -> dict[str, Any]:
    catalog = load_catalog()
    require_known_app("status", app_id)
    app = next(
        (
            item
            for item in catalog["apps"]
            if isinstance(item, dict) and item.get("id") == app_id
        ),
        None,
    )
    if app is None:
        error("status", "catalog_mismatch", f"App {app_id} fehlt im Katalog.", EXIT_CATALOG_ERROR)
    transient = hyprland_window_state(catalog)
    return {"app": app, "runtime": runtime_state(app, transient)}





def _notification_state_path() -> Path:
    base = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state")))
    return base / "caelestia-webapps" / "notification-events.json"


def _notification_watcher_pid_path() -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR", "").strip()
    base = Path(runtime) if runtime else Path.home() / ".local/state"
    return base / "caelestia-webapps" / "notification-watch.pid"


def _pid_is_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return False
    return True


def ensure_notification_watcher() -> None:
    """Best-effort singleton autostart for notification integrations.

    status-feed is polled by the plugin, so it is a reliable public runtime
    boundary. The watcher itself owns an advisory singleton lock; the pid file
    only avoids spawning short-lived contenders on every poll.
    """
    pid_path = _notification_watcher_pid_path()
    try:
        pid = int(pid_path.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        pid = 0
    if _pid_is_alive(pid):
        return

    try:
        subprocess.Popen(
            [sys.executable, str(NOTIFICATION_WATCH_TOOL), "--quiet"],
            cwd=ROOT,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=os.environ.copy(),
            start_new_session=True,
            close_fds=True,
        )
    except OSError:
        return


def notification_items_for_app(app_id: str) -> list[dict[str, Any]]:
    path = _notification_state_path()
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []
    events = payload.get("events", []) if isinstance(payload, dict) else []
    if not isinstance(events, list):
        return []
    now = int(time.time())
    ttl = 6 * 60 * 60
    result = [
        item for item in events
        if isinstance(item, dict)
        and str(item.get("appId", "")) == app_id
        and now - int(item.get("timestamp", 0) or 0) <= ttl
    ]
    result.sort(key=lambda item: int(item.get("timestamp", 0) or 0), reverse=True)
    return result[:20]



def _playerctl(args: list[str], timeout: float = 1.5) -> tuple[int, str]:
    try:
        proc = subprocess.run(
            ["playerctl", *args],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return 127, ""
    return proc.returncode, proc.stdout.strip()


def _normalise_host(value: str) -> str:
    raw = str(value or "").strip()
    if not raw:
        return ""

    # urlparse() treats a bare hostname (e.g. "youtube.com") as a path and
    # therefore exposes no .hostname. Registry matchHosts intentionally store
    # hostnames rather than full URLs, so parse bare hosts through a temporary
    # scheme-relative form while preserving normal URL handling.
    candidate = raw if "://" in raw or raw.startswith("//") else f"//{raw}"
    try:
        host = (urlparse(candidate).hostname or "").lower().strip(".")
    except ValueError:
        return ""
    return host[4:] if host.startswith("www.") else host


def _state_root() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "caelestia-webapps"




def _applet_activation_path() -> Path:
    return _state_root() / "applets.json"


def _read_applet_activation_overrides() -> dict[str, bool]:
    path = _applet_activation_path()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    if not isinstance(data, dict) or data.get("schemaVersion", 1) != 1:
        return {}
    enabled = data.get("enabled", {})
    if not isinstance(enabled, dict):
        return {}
    return {str(key): bool(value) for key, value in enabled.items()}


def applet_activation_available(entry: dict[str, Any]) -> bool:
    # Phase 16.5 only exposes activation for implementations that are already
    # part of the supported runtime mapping. Experimental registry entries are
    # intentionally not presented as activatable until an implementation exists.
    return str(entry.get("support", "")) == "supported"


def applet_enabled(app_id: str, entry: dict[str, Any] | None = None) -> bool:
    runtime_entry = entry if isinstance(entry, dict) else applet_runtime_entry("applet-state", app_id)
    overrides = _read_applet_activation_overrides()
    if app_id in overrides:
        return bool(overrides[app_id])
    return bool(runtime_entry.get("defaultEnabled", False))


def set_applet_enabled(app_id: str, enabled: bool) -> None:
    path = _applet_activation_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    data = {"schemaVersion": 1, "enabled": {}}
    try:
        current = json.loads(path.read_text(encoding="utf-8"))
        if isinstance(current, dict):
            data = current
    except (OSError, json.JSONDecodeError):
        pass
    data["schemaVersion"] = 1
    values = data.get("enabled")
    if not isinstance(values, dict):
        values = {}
    values[app_id] = bool(enabled)
    data["enabled"] = values
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    tmp.replace(path)


def _applet_settings_path() -> Path:
    return _state_root() / "applet-settings.json"


def _read_applet_settings_overrides() -> dict[str, dict[str, bool]]:
    path = _applet_settings_path()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    if not isinstance(data, dict) or data.get("schemaVersion", 1) != 1:
        return {}
    apps = data.get("apps", {})
    if not isinstance(apps, dict):
        return {}
    result: dict[str, dict[str, bool]] = {}
    for app_id, values in apps.items():
        if not isinstance(values, dict):
            continue
        result[str(app_id)] = {str(key): bool(value) for key, value in values.items()}
    return result


def applet_capability_enabled(app_id: str, capability: str, entry: dict[str, Any] | None = None) -> bool:
    runtime_entry = entry if isinstance(entry, dict) else applet_runtime_entry("applet-settings", app_id)
    capabilities = [str(value) for value in runtime_entry.get("capabilities", []) if value]
    if capability not in capabilities:
        return False
    overrides = _read_applet_settings_overrides().get(app_id, {})
    return bool(overrides.get(capability, True))


def set_applet_capability(app_id: str, capability: str, enabled: bool, entry: dict[str, Any] | None = None) -> None:
    runtime_entry = entry if isinstance(entry, dict) else applet_runtime_entry("applet-setting-set", app_id)
    capabilities = [str(value) for value in runtime_entry.get("capabilities", []) if value]
    if capability not in capabilities:
        error("applet-setting-set", "unknown_capability", f"Applet {app_id} besitzt Capability {capability} nicht.", EXIT_ACTION_FAILED)
    path = _applet_settings_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    data: dict[str, Any] = {"schemaVersion": 1, "apps": {}}
    try:
        current = json.loads(path.read_text(encoding="utf-8"))
        if isinstance(current, dict):
            data = current
    except (OSError, json.JSONDecodeError):
        pass
    data["schemaVersion"] = 1
    apps = data.get("apps")
    if not isinstance(apps, dict):
        apps = {}
    values = apps.get(app_id)
    if not isinstance(values, dict):
        values = {}
    values[capability] = bool(enabled)
    apps[app_id] = values
    data["apps"] = apps
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    tmp.replace(path)


def applet_settings_payload(app_id: str | None = None) -> dict[str, Any]:
    registry = load_applet_registry()
    items: list[dict[str, Any]] = []
    for entry in registry.get("apps", []):
        if not isinstance(entry, dict) or not entry.get("id"):
            continue
        entry_id = str(entry["id"])
        if app_id is not None and entry_id != app_id:
            continue
        capabilities = [str(value) for value in entry.get("capabilities", []) if value]
        settings = {cap: applet_capability_enabled(entry_id, cap, entry) for cap in capabilities}
        items.append({
            "appId": entry_id,
            "support": str(entry.get("support", "experimental")),
            "capabilities": capabilities,
            "settings": settings,
        })
    if app_id is not None and not items:
        error("applet-settings", "applet_not_available", f"App {app_id} besitzt keine Applet-Runtime-Registry.", EXIT_CATALOG_ERROR)
    return {"schemaVersion": 1, "apps": items}


def applet_activation_payload(app_id: str | None = None) -> dict[str, Any]:
    registry = load_applet_registry()
    catalog = load_catalog()
    installed = {
        str(app.get("id")): bool(app.get("installed", False))
        for app in catalog.get("apps", [])
        if isinstance(app, dict) and app.get("id")
    }
    items = []
    for entry in registry.get("apps", []):
        if not isinstance(entry, dict) or not entry.get("id"):
            continue
        entry_id = str(entry["id"])
        if app_id is not None and entry_id != app_id:
            continue
        items.append({
            "appId": entry_id,
            "enabled": applet_enabled(entry_id, entry),
            "activationAvailable": applet_activation_available(entry),
            "installed": bool(installed.get(entry_id, False)),
            "support": str(entry.get("support", "experimental")),
        })
    if app_id is not None and not items:
        error("applet-state", "applet_not_available", f"App {app_id} besitzt keine Applet-Runtime-Registry.", EXIT_CATALOG_ERROR)
    return {"schemaVersion": 1, "apps": items}

def _pin_state_path() -> Path:
    return _state_root() / "pins.json"


def pin_state(app_id: str) -> bool:
    path = _pin_state_path()
